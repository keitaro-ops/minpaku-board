# Postgres 接続文字列（Supabase の Transaction pooler URL 推奨）
DATABASE_URL=postgres://user:pass@host:6543/postgres

# 役割ごとの合言葉（3種）。配る相手ごとに別のパスワードを設定。
ADMIN_PASSWORD=管理者用の強いパスワード
STAFF_PASSWORD=運用者用のパスワード
VIEWER_PASSWORD=清掃現場用のパスワード（見るだけ・清掃操作なし）
CLEANING2_PASSWORD=清掃責任者用のパスワード（清掃予定を編集可）

# 旧: 単一パスワード（設定するとADMIN扱い。ADMIN_PASSWORDがあればそちら優先）
DASHBOARD_PASSWORD=

# Cookie署名用のランダムな長い文字列
APP_SECRET=please-generate-a-random-64-char-string

# 定期同期ジョブ用の秘密トークン（GitHub Actions から渡す）
CRON_SECRET=another-random-string
